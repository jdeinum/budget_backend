# Copy to .env (gitignored) and fill in real values.

# Plaid credentials — from the Plaid Dashboard. Use the sandbox secret while
# plaid.env = "sandbox" in config/default.toml.
BUDGET__PLAID__CLIENT_ID=your_plaid_client_id
BUDGET__PLAID__SECRET=your_plaid_sandbox_secret

# Overrides config/default.toml's database.url if set. Also used directly by
# `sqlx-cli` (cargo sqlx migrate ...), which does not read config/*.toml.
DATABASE_URL=sqlite://data/budget.db
BUDGET__DATABASE__URL=sqlite://data/budget.db
